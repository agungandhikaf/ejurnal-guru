{
  "name": "ejurnal-guru",
  "version": "1.0.3",
  "description": "Aplikasi desktop E-Jurnal Guru untuk macOS Apple Silicon",
  "main": "./out/main/index.js",
  "author": "E-Jurnal Guru",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "cross-env APP_ENV=dev electron-vite dev",
    "dev:prod": "cross-env APP_ENV=prod electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm run typecheck && npm run build",
    "dist:dev": "cross-env APP_ENV=dev electron-vite build && electron-builder --config electron-builder.dev.yml --mac dmg zip --arm64 --publish never",
    "dist:prod": "cross-env APP_ENV=prod electron-vite build && electron-builder --config electron-builder.prod.yml --mac dmg zip --arm64 --publish never",
    "release:prod": "cross-env APP_ENV=prod electron-vite build && electron-builder --config electron-builder.prod.yml --mac dmg zip --arm64 --publish always",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "11.10.0",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  }
}
